# ============================================================
# UNEMI Guide AI - Variables de entorno (PLANTILLA)
# Copia este archivo como ".env" y completa los valores.
# El archivo .env NUNCA se sube a git.
# ============================================================

# --- Django ---
DJANGO_SECRET_KEY=pon-aqui-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
# Solo se usa cuando DJANGO_DEBUG=False (separados por coma):
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos (opcional; por defecto backend/db.sqlite3) ---
# SQLITE_PATH=C:\ruta\a\otra\base.sqlite3

# --- Correo Gmail (contraseña de APLICACIÓN, no la de tu cuenta) ---
# Si dejas usuario o contraseña vacíos, los correos salen en la consola.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Frontend: cambia el número para forzar la recarga de CSS/JS ---
VERSION_ESTATICOS=1.1.0

# --- Visión artificial (vacío = modo simulado) ---
# IA_SERVICE_URL=http://127.0.0.1:8001/detectar

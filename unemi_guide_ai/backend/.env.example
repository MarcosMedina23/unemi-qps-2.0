# ============================================================
# UNEMI Guide AI - Variables de entorno (PLANTILLA)
# Copia este archivo como ".env" y completa los valores.
# El archivo .env NUNCA se sube a git (contiene contraseñas).
# ============================================================

# --- Django ---
DJANGO_SECRET_KEY=pon-aqui-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
# Solo se usa cuando DJANGO_DEBUG=False (separados por coma):
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Solo en el servidor: tu dominio con https (separados por coma).
# DJANGO_CSRF_TRUSTED_ORIGINS=https://unemi-guide.duckdns.org
# Solo en el servidor: pon False si todavía no tienes certificado https.
# DJANGO_HTTPS=True

# --- Crear cuenta desde la página (/registro/) ---
# Vacío = cualquier correo. Con dominios (separados por coma) solo se aceptan esos.
# Ej: REGISTRO_DOMINIOS=unemi.edu.ec
REGISTRO_DOMINIOS=

# --- Base de datos (opcional; por defecto backend/db.sqlite3) ---
# SQLITE_PATH=C:\ruta\a\otra\base.sqlite3

# --- Correo (activar cuenta, recuperar contraseña y usuario) ---
# Cuenta que ENVÍA los correos. EMAIL_HOST_PASSWORD es una contraseña de
# APLICACIÓN de 16 letras (no la contraseña normal). Ver README.
# Si EMAIL_HOST_PASSWORD queda vacío, los correos salen en la consola.
#   Cuenta de Google / Gmail:       EMAIL_HOST=smtp.gmail.com      EMAIL_PORT=587
#   Cuenta de Microsoft / Outlook:  EMAIL_HOST=smtp.office365.com  EMAIL_PORT=587
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=mmedinal2@unemi.edu.ec
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=UNEMI Guide AI <mmedinal2@unemi.edu.ec>

# --- Microservicio de IA (ia_service, YOLOv8 con best.pt) ---
# Vacío = no se usa (modelo local o simulado). Con el servicio encendido:
# IA_SERVICE_URL=http://127.0.0.1:8001/predict
IA_SERVICE_URL=
# False = con el modelo real: si la IA falla, NO inventa una zona (muestra un aviso).
# True  = si la IA falla o no hay modelo, usa la simulación (solo para pruebas).
IA_PERMITIR_SIMULACION=True

